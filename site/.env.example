# Environment variables for ALMAS.
#
# Preview (default):
NEXT_PUBLIC_CONTENT_MODE=preview
NEXT_PUBLIC_ALLOW_INDEXING=false
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public production build (also enforced by scripts/build-production.mjs):
# NEXT_PUBLIC_CONTENT_MODE=production
# NEXT_PUBLIC_ALLOW_INDEXING=true
# NEXT_PUBLIC_SITE_URL=https://www.example.ch
